# Variables de entorno requeridas para Gestión SySO

# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mercado Pago Config
MERCADO_PAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# SMTP Config (Google Workspace / Gmail / SMTP Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@gestionsyso.com
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@gestionsyso.com
SMTP_SENDER_NAME="Gestión SySO"
SUPPORT_EMAIL=soporte@gestionsyso.com
CONTACT_EMAIL=contacto@gestionsyso.com

# App Config
APP_URL=http://localhost:3000
NODE_ENV=development

# Upstash Redis / Vercel KV (Distributed Rate Limiting)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
# O bien las inyectadas automáticamente por la integración de Vercel:
KV_REST_API_URL=your-kv-rest-api-url
KV_REST_API_TOKEN=your-kv-rest-api-token


# Google Gemini API Config
GEMINI_API_KEY=your-gemini-api-key

# SuperAdmin Authorization (comma-separated emails)
SUPERADMIN_EMAILS=sebastian.merlassino@gestionsyso.com
NEXT_PUBLIC_SUPERADMIN_EMAILS=sebastian.merlassino@gestionsyso.com

# Sentry Config (Error Tracking & Performance)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog Config (Product Analytics & Session Replay)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


